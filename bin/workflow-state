#!/usr/bin/env python3
import argparse
import json
import os
import sys
import tempfile
import re
from datetime import datetime, timezone

from workflow_contract import allowed_phase_name, load_manifest, manifest_path_from_state


UUID_RE = re.compile(
    r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-"
    r"[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
)


def now_iso():
    return datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds")


def load_state(path):
    if not os.path.exists(path):
        return {"phases": {}}
    with open(path, "r", encoding="utf-8") as f:
        return json.load(f)


def save_state(path, state):
    directory = os.path.dirname(os.path.abspath(path))
    os.makedirs(directory, exist_ok=True)
    fd, tmp_path = tempfile.mkstemp(prefix=".workflow-state.", suffix=".tmp", dir=directory)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(state, f, ensure_ascii=False, indent=2)
            f.write("\n")
        os.replace(tmp_path, path)
    finally:
        if os.path.exists(tmp_path):
            os.unlink(tmp_path)


def get_phase(state, phase):
    return state.setdefault("phases", {}).setdefault(phase, {})


def require_allowed_phase_name(state, phase_name):
    manifest_path = manifest_path_from_state(state)
    if not manifest_path:
        return
    if not os.path.isfile(manifest_path):
        raise ValueError(f"workflow manifest not found: {manifest_path}")
    if not allowed_phase_name(load_manifest(manifest_path), phase_name):
        raise ValueError(f"phase is not allowed by workflow manifest: {phase_name}")


def require_running_phase(state, phase_name):
    require_allowed_phase_name(state, phase_name)
    phase = state.get("phases", {}).get(phase_name)
    if phase is None:
        raise ValueError(f"phase has not been started: {phase_name}")
    if phase.get("status") != "running":
        raise ValueError(f"phase is not running: {phase_name}")
    return phase


def finish_phase(state, phase_name, status, exit_code, output_file):
    phase = require_running_phase(state, phase_name)
    phase.update({
        "status": status,
        "exit_code": exit_code,
        "ended_at": now_iso(),
    })
    if output_file:
        phase["output_file"] = output_file


def cmd_init(args):
    state = load_state(args.file)
    state.update({
        "task_name": args.task_name,
        "provider": args.provider,
        "model": args.model,
        "project_dir": args.project_dir,
        "workspace_dir": args.workspace_dir,
        "updated_at": now_iso(),
    })
    state.setdefault("workflow_id", args.workflow_id)
    state.setdefault("created_at", now_iso())
    # Preserve existing phase records on resume; orchestrate.sh relies on them for state-driven skipping.
    state.setdefault("phases", {})
    save_state(args.file, state)


def cmd_phase_start(args):
    state = load_state(args.file)
    require_allowed_phase_name(state, args.phase)
    phase = get_phase(state, args.phase)
    phase.update({
        "status": "running",
        "provider": args.provider,
        "model": args.model,
        "session_name": args.session_name,
        "output_file": args.output_file,
        "prompt_file": args.prompt_file,
        "run_script": args.run_script,
        "started_at": now_iso(),
        "started_epoch": args.started_epoch,
    })
    state["updated_at"] = now_iso()
    save_state(args.file, state)


def cmd_phase_finish(args):
    state = load_state(args.file)
    finish_phase(state, args.phase, args.status, args.exit_code, args.output_file)
    state["updated_at"] = now_iso()
    save_state(args.file, state)


def cmd_phase_finish_active(args):
    state = load_state(args.file)
    phase_name = state.get("metadata", {}).get("current_phase")
    if not isinstance(phase_name, str) or not phase_name:
        raise ValueError("metadata.current_phase is required to finish the active phase")
    finish_phase(state, phase_name, args.status, args.exit_code, args.output_file)
    state["updated_at"] = now_iso()
    save_state(args.file, state)


def cmd_set_session_id(args):
    state = load_state(args.file)
    phase = require_running_phase(state, args.phase)
    phase["session_id"] = args.session_id
    state["updated_at"] = now_iso()
    save_state(args.file, state)


def cmd_set_main_agent(args):
    if not UUID_RE.fullmatch(args.session_id):
        raise ValueError(f"main agent session id must be a UUID: {args.session_id}")
    state = load_state(args.file)
    state["main_agent"] = {
        "provider": args.provider,
        "session_id": args.session_id,
        "recorded_at": now_iso(),
    }
    state["updated_at"] = now_iso()
    save_state(args.file, state)


def cmd_set_workflow_meta(args):
    state = load_state(args.file)
    state.setdefault("metadata", {})[args.key] = args.value
    state["updated_at"] = now_iso()
    save_state(args.file, state)


def cmd_set_phase_field(args):
    state = load_state(args.file)
    require_allowed_phase_name(state, args.phase)
    phase = state.get("phases", {}).get(args.phase)
    if phase is None:
        raise ValueError(f"phase has not been started: {args.phase}")
    phase[args.key] = args.value
    state["updated_at"] = now_iso()
    save_state(args.file, state)


def cmd_get(args, key):
    state = load_state(args.file)
    phase = state.get("phases", {}).get(args.phase, {})
    value = phase.get(key, "")
    if value is None:
        value = ""
    print(value)


def cmd_get_phase_field(args):
    cmd_get(args, args.key)


def cmd_get_workflow_meta(args):
    state = load_state(args.file)
    value = state.get("metadata", {}).get(args.key, "")
    if value is None:
        value = ""
    print(value)


def cmd_get_main_agent(args, key):
    state = load_state(args.file)
    value = state.get("main_agent", {}).get(key, "")
    if value is None:
        value = ""
    print(value)


def build_parser():
    parser = argparse.ArgumentParser(description="Read and update j-workflow state JSON.")
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("init")
    p.add_argument("--file", required=True)
    p.add_argument("--workflow-id", required=True)
    p.add_argument("--task-name", required=True)
    p.add_argument("--provider", required=True)
    p.add_argument("--model", required=True)
    p.add_argument("--project-dir", required=True)
    p.add_argument("--workspace-dir", required=True)
    p.set_defaults(func=cmd_init)

    p = sub.add_parser("phase-start")
    p.add_argument("--file", required=True)
    p.add_argument("--phase", required=True)
    p.add_argument("--provider", required=True)
    p.add_argument("--model", required=True)
    p.add_argument("--session-name", required=True)
    p.add_argument("--output-file", required=True)
    p.add_argument("--prompt-file", required=True)
    p.add_argument("--run-script", required=True)
    p.add_argument("--started-epoch", required=True)
    p.set_defaults(func=cmd_phase_start)

    p = sub.add_parser("phase-finish")
    p.add_argument("--file", required=True)
    p.add_argument("--phase", required=True)
    p.add_argument("--status", required=True, choices=["done", "failed", "skipped"])
    p.add_argument("--exit-code", required=True)
    p.add_argument("--output-file")
    p.set_defaults(func=cmd_phase_finish)

    p = sub.add_parser("phase-finish-active")
    p.add_argument("--file", required=True)
    p.add_argument("--status", required=True, choices=["done", "failed", "skipped"])
    p.add_argument("--exit-code", required=True)
    p.add_argument("--output-file")
    p.set_defaults(func=cmd_phase_finish_active)

    p = sub.add_parser("set-session-id")
    p.add_argument("--file", required=True)
    p.add_argument("--phase", required=True)
    p.add_argument("--session-id", required=True)
    p.set_defaults(func=cmd_set_session_id)

    p = sub.add_parser("set-main-agent")
    p.add_argument("--file", required=True)
    p.add_argument("--provider", required=True, choices=["claude", "codex"])
    p.add_argument("--session-id", required=True)
    p.set_defaults(func=cmd_set_main_agent)

    p = sub.add_parser("set-workflow-meta")
    p.add_argument("--file", required=True)
    p.add_argument("--key", required=True)
    p.add_argument("--value", required=True)
    p.set_defaults(func=cmd_set_workflow_meta)

    p = sub.add_parser("set-phase-field")
    p.add_argument("--file", required=True)
    p.add_argument("--phase", required=True)
    p.add_argument("--key", required=True)
    p.add_argument("--value", required=True)
    p.set_defaults(func=cmd_set_phase_field)

    p = sub.add_parser("get-session-id")
    p.add_argument("--file", required=True)
    p.add_argument("--phase", required=True)
    p.set_defaults(func=lambda args: cmd_get(args, "session_id"))

    p = sub.add_parser("get-phase-status")
    p.add_argument("--file", required=True)
    p.add_argument("--phase", required=True)
    p.set_defaults(func=lambda args: cmd_get(args, "status"))

    p = sub.add_parser("get-phase-field")
    p.add_argument("--file", required=True)
    p.add_argument("--phase", required=True)
    p.add_argument("--key", required=True)
    p.set_defaults(func=cmd_get_phase_field)

    p = sub.add_parser("get-workflow-meta")
    p.add_argument("--file", required=True)
    p.add_argument("--key", required=True)
    p.set_defaults(func=cmd_get_workflow_meta)

    p = sub.add_parser("get-main-agent-session-id")
    p.add_argument("--file", required=True)
    p.set_defaults(func=lambda args: cmd_get_main_agent(args, "session_id"))

    p = sub.add_parser("get-main-agent-provider")
    p.add_argument("--file", required=True)
    p.set_defaults(func=lambda args: cmd_get_main_agent(args, "provider"))

    return parser


def main():
    args = build_parser().parse_args()
    try:
        args.func(args)
    except Exception as exc:
        print(f"[ERROR] workflow-state: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
