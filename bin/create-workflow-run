#!/usr/bin/env python3
import argparse
import copy
import json
import os
import sys
from datetime import datetime, timezone


def now_iso():
    return datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds")


def load_json(path):
    with open(path, "r", encoding="utf-8") as f:
        return json.load(f)


def save_json(path, data):
    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
        f.write("\n")


def phase_ids(manifest):
    return [phase["id"] for phase in manifest.get("phases", [])]


def phase_map(manifest):
    return {phase["id"]: phase for phase in manifest.get("phases", [])}


def ordered_unique(values):
    seen = set()
    result = []
    for value in values:
        if value not in seen:
            seen.add(value)
            result.append(value)
    return result


def build_order(manifest, args):
    execution = manifest.get("execution", {})
    base_order = execution.get(f"{args.mode}_order") or execution.get("order") or execution.get("skill_order") or phase_ids(manifest)
    disabled = set(args.disable or [])
    enabled = set(args.enable or [])

    order = []
    for phase_id in base_order:
        if phase_id in disabled:
            continue
        phase = next((item for item in manifest.get("phases", []) if item.get("id") == phase_id), {})
        default_enabled = phase.get("enabled_by_default", True)
        if default_enabled is False and phase_id not in enabled:
            continue
        order.append(phase_id)

    return ordered_unique(order)


def build_breakpoints(manifest, args):
    phases = phase_map(manifest)
    breakpoints = {
        phase_id: bool(phase.get("breakpoint_after", False))
        for phase_id, phase in phases.items()
    }
    for phase_id in args.break_phase or []:
        if phase_id not in phases:
            raise ValueError(f"unknown phase for --break: {phase_id}")
        breakpoints[phase_id] = True
    for phase_id in args.no_break_phase or []:
        if phase_id not in phases:
            raise ValueError(f"unknown phase for --no-break: {phase_id}")
        breakpoints[phase_id] = False
    return breakpoints


def main():
    parser = argparse.ArgumentParser(description="Create a workspace-level j-workflow run file from a template manifest.")
    parser.add_argument("--template", required=True)
    parser.add_argument("--output", required=True)
    parser.add_argument("--mode", required=True, choices=["shell", "skill"])
    parser.add_argument("--task-name", required=True)
    parser.add_argument("--provider", required=True)
    parser.add_argument("--model", required=True)
    parser.add_argument("--max-rounds", type=int, default=3)
    parser.add_argument("--break", dest="break_phase", action="append", default=[])
    parser.add_argument("--no-break", dest="no_break_phase", action="append", default=[])
    parser.add_argument("--enable", action="append", default=[])
    parser.add_argument("--disable", action="append", default=[])
    args = parser.parse_args()
    if args.max_rounds < 0:
        raise ValueError("--max-rounds must be a non-negative integer")

    template_path = os.path.abspath(args.template)
    manifest = load_json(template_path)
    run = copy.deepcopy(manifest)
    order = build_order(run, args)

    run["kind"] = "run"
    run["source_manifest"] = template_path
    run["task_name"] = args.task_name
    run["provider"] = args.provider
    run["model"] = args.model
    run["generated_at"] = now_iso()
    run.setdefault("execution", {})["order"] = order
    run["execution"]["mode"] = args.mode
    run["execution"]["max_rounds"] = args.max_rounds
    run["execution"]["breakpoints"] = build_breakpoints(run, args)
    run["execution"]["disabled"] = [phase_id for phase_id in phase_ids(run) if phase_id not in set(order)]

    save_json(args.output, run)
    print(os.path.abspath(args.output))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:
        print(f"[ERROR] create-workflow-run: {exc}", file=sys.stderr)
        raise SystemExit(1)
