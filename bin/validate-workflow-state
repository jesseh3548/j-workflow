#!/usr/bin/env python3
import json
import os
import re
import sys

from workflow_contract import load_manifest, manifest_path_from_state, validate_state_phase_names


ALLOWED_PHASE_STATUS = {"running", "done", "failed", "skipped"}
UUID_RE = re.compile(
    r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-"
    r"[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
)


def require_string(obj, key, where):
    value = obj.get(key)
    if not isinstance(value, str) or not value:
        raise ValueError(f"{where}.{key} must be a non-empty string")


def require_optional_string(obj, key, where):
    if key in obj and obj[key] is not None and not isinstance(obj[key], str):
        raise ValueError(f"{where}.{key} must be a string")


def validate_phase(name, phase):
    where = f"phases.{name}"
    if not isinstance(phase, dict):
        raise ValueError(f"{where} must be an object")

    if "status" in phase:
        status = phase["status"]
        if status not in ALLOWED_PHASE_STATUS:
            raise ValueError(f"{where}.status has invalid value: {status}")

    for key in (
        "provider",
        "model",
        "session_name",
        "output_file",
        "prompt_file",
        "run_script",
        "started_at",
        "started_epoch",
        "ended_at",
        "exit_code",
        "session_id",
        "round",
        "loop",
        "transition",
        "resume_from",
    ):
        require_optional_string(phase, key, where)

    if phase.get("status") == "running":
        for key in ("provider", "model", "session_name", "output_file", "prompt_file", "run_script", "started_at"):
            require_string(phase, key, where)

    if phase.get("status") in {"done", "failed", "skipped"}:
        require_string(phase, "ended_at", where)
        require_string(phase, "exit_code", where)


def validate_state(data, manifest_path=None):
    if not isinstance(data, dict):
        raise ValueError("workflow state must be an object")

    for key in ("workflow_id", "task_name", "provider", "model", "project_dir", "workspace_dir", "created_at", "updated_at"):
        require_string(data, key, "state")

    if "metadata" in data:
        metadata = data["metadata"]
        if not isinstance(metadata, dict):
            raise ValueError("state.metadata must be an object")
        for key, value in metadata.items():
            if not isinstance(key, str) or not isinstance(value, str):
                raise ValueError("state.metadata must map strings to strings")

    if "main_agent" in data:
        main_agent = data["main_agent"]
        if not isinstance(main_agent, dict):
            raise ValueError("state.main_agent must be an object")
        for key in ("provider", "session_id", "recorded_at"):
            require_string(main_agent, key, "state.main_agent")
        if main_agent["provider"] not in {"claude", "codex"}:
            raise ValueError(f"state.main_agent.provider has invalid value: {main_agent['provider']}")
        if not UUID_RE.fullmatch(main_agent["session_id"]):
            raise ValueError("state.main_agent.session_id must be a UUID")

    phases = data.get("phases")
    if not isinstance(phases, dict):
        raise ValueError("state.phases must be an object")
    for name, phase in phases.items():
        if not isinstance(name, str) or not name:
            raise ValueError("phase names must be non-empty strings")
        validate_phase(name, phase)

    resolved_manifest = manifest_path or manifest_path_from_state(data)
    if resolved_manifest:
        if not os.path.isfile(resolved_manifest):
            raise ValueError(f"workflow manifest not found: {resolved_manifest}")
        errors = validate_state_phase_names(data, load_manifest(resolved_manifest))
        if errors:
            raise ValueError(errors[0])


def main():
    import argparse

    parser = argparse.ArgumentParser(description="Validate a j-workflow runtime state.")
    parser.add_argument("state_file")
    parser.add_argument("--manifest")
    args = parser.parse_args()

    path = args.state_file
    if not os.path.isfile(path):
        print(f"[ERROR] workflow state not found: {path}", file=sys.stderr)
        return 1

    with open(path, "r", encoding="utf-8") as f:
        data = json.load(f)

    validate_state(data, args.manifest)
    print("ok")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:
        print(f"[ERROR] validate-workflow-state: {exc}", file=sys.stderr)
        raise SystemExit(1)
