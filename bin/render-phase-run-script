#!/usr/bin/env python3
import argparse
import os
import shlex
import stat


ENV_VARS = [
    "ANTHROPIC_AUTH_TOKEN",
    "ANTHROPIC_API_KEY",
    "ANTHROPIC_BEDROCK_BASE_URL",
    "ANTHROPIC_MODEL",
    "ANTHROPIC_SMALL_FAST_MODEL",
    "CLAUDE_CODE_USE_BEDROCK",
    "CLAUDE_CODE_SKIP_BEDROCK_AUTH",
    "CLAUDE_CODE_USE_VERTEX",
    "OPENAI_API_KEY",
    "CODEX_HOME",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_SESSION_TOKEN",
    "AWS_REGION",
    "HOME",
]


def q(value):
    return shlex.quote(value)


def env_exports():
    lines = []
    for name in ENV_VARS:
        value = os.environ.get(name)
        if value:
            lines.append(f"export {name}={q(value)}")
    return "\n".join(lines)


def prompt_arg(prompt_file):
    return f'"$(cat {q(prompt_file)})"'


def render_provider_command(args):
    cli = q(args.provider_cli)
    model = q(args.model)
    project_dir = q(args.project_dir)
    prompt = prompt_arg(args.prompt_file)

    if args.provider == "claude":
        if args.resume_session_id:
            return f"""{cli} \\
    --model {model} \\
    --resume {q(args.resume_session_id)} \\
    --add-dir {project_dir} \\
    --permission-mode default \\
    --verbose \\
    -- {prompt}"""
        if args.resume_session_name:
            return f"""{cli} \\
    --model {model} \\
    --add-dir {project_dir} \\
    --permission-mode default \\
    --verbose \\
    --resume {q(args.resume_session_name)} \\
    -- {prompt}"""
        return f"""{cli} \\
    --model {model} \\
    --name {q(args.session_name)} \\
    --add-dir {project_dir} \\
    --permission-mode default \\
    --verbose \\
    -- {prompt}"""

    if args.provider == "codex":
        if args.resume_session_id:
            return f"""{cli} resume \\
    -m {model} \\
    -C {project_dir} \\
    {q(args.resume_session_id)} \\
    {prompt}"""
        return f"""{cli} \\
    -m {model} \\
    -C {project_dir} \\
    {prompt}"""

    raise ValueError(f"Unsupported provider: {args.provider}")


def render_script(args):
    exports = env_exports()
    provider_command = render_provider_command(args)
    state_file = q(args.state_file)
    workflow_state = q(args.workflow_state)
    phase = q(args.phase)
    output_file = q(args.output_file)
    return f"""#!/bin/bash
export NODE_TLS_REJECT_UNAUTHORIZED=0
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH"
swift -e 'import Carbon; let s = TISCreateInputSourceList([kTISPropertyInputSourceID: "com.apple.keylayout.ABC" as CFString] as CFDictionary, false)!.takeRetainedValue() as! [TISInputSource]; if let i = s.first {{ TISSelectInputSource(i) }}' 2>/dev/null || true
{exports}
cd {q(args.project_dir)}
echo "$$" > {q(args.started_marker)}
echo -e "\\033[1;36m════════════════════════════════════════\\033[0m"
echo -e "\\033[1;36m  Session: {args.session_name}\\033[0m"
echo -e "\\033[1;36m  Provider:{args.provider}\\033[0m"
echo -e "\\033[1;36m  CLI:     {args.provider_cli}\\033[0m"
echo -e "\\033[1;36m  Model:   {args.model}\\033[0m"
echo -e "\\033[1;36m  Project: {args.project_dir}\\033[0m"
echo -e "\\033[1;36m════════════════════════════════════════\\033[0m"
echo ""
{provider_command}
EXIT_CODE=$?

PHASE_STATUS="$({workflow_state} get-phase-status --file {state_file} --phase {phase} 2>/dev/null || true)"
if [[ "$PHASE_STATUS" == "running" ]]; then
    PHASE_RESULT="done"
    if [[ "$EXIT_CODE" != "0" ]]; then
        PHASE_RESULT="failed"
    fi
    {workflow_state} phase-finish \\
        --file {state_file} \\
        --phase {phase} \\
        --status "$PHASE_RESULT" \\
        --exit-code "$EXIT_CODE" \\
        --output-file {output_file}
fi
"""


def build_parser():
    parser = argparse.ArgumentParser(description="Render an interactive j-workflow phase run script.")
    parser.add_argument("--output", required=True)
    parser.add_argument("--provider", required=True, choices=["claude", "codex"])
    parser.add_argument("--provider-cli", required=True)
    parser.add_argument("--model", required=True)
    parser.add_argument("--project-dir", required=True)
    parser.add_argument("--session-name", required=True)
    parser.add_argument("--prompt-file", required=True)
    parser.add_argument("--started-marker", required=True)
    parser.add_argument("--workflow-state", required=True)
    parser.add_argument("--state-file", required=True)
    parser.add_argument("--phase", required=True)
    parser.add_argument("--output-file", required=True)
    parser.add_argument("--resume-session-id", default="")
    parser.add_argument("--resume-session-name", default="")
    return parser


def main():
    args = build_parser().parse_args()
    script = render_script(args)
    with open(args.output, "w", encoding="utf-8") as f:
        f.write(script)
    mode = os.stat(args.output).st_mode
    os.chmod(args.output, mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
