#!/bin/bash
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: ghostty-open-tab --script <path> --cwd <dir> [--verify-file <path>] [--window-id <id>]

Open a Ghostty tab or window and run the provided script.
EOF
}

SCRIPT_PATH=""
WORKING_DIR=""
VERIFY_FILE=""
GHOSTTY_WINDOW_ID=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --script) SCRIPT_PATH="$2"; shift 2 ;;
        --cwd) WORKING_DIR="$2"; shift 2 ;;
        --verify-file) VERIFY_FILE="$2"; shift 2 ;;
        --window-id) GHOSTTY_WINDOW_ID="$2"; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        *) echo "[ERROR] unknown argument: $1" >&2; usage; exit 1 ;;
    esac
done

if [[ -z "$SCRIPT_PATH" || -z "$WORKING_DIR" ]]; then
    usage >&2
    exit 1
fi

if [[ ! -f "$SCRIPT_PATH" ]]; then
    echo "[ERROR] script does not exist: $SCRIPT_PATH" >&2
    exit 1
fi

switch_to_abc_input() {
    if ! command -v swift >/dev/null 2>&1; then
        return
    fi
    swift -e 'import Carbon; let s = TISCreateInputSourceList([kTISPropertyInputSourceID: "com.apple.keylayout.ABC" as CFString] as CFDictionary, false)!.takeRetainedValue() as! [TISInputSource]; if let i = s.first { TISSelectInputSource(i) }' 2>/dev/null || true
}

detect_window() {
    if [[ -n "$GHOSTTY_WINDOW_ID" ]]; then
        return
    fi

    GHOSTTY_WINDOW_ID=$(osascript -e "
        tell application \"Ghostty\"
            if (count of windows) > 0 then
                return id of window 1
            else
                return \"not_found\"
            end if
        end tell
    " 2>/dev/null || echo "not_found")

    if [[ "$GHOSTTY_WINDOW_ID" == "not_found" ]]; then
        GHOSTTY_WINDOW_ID=""
    fi
}

open_surface() {
    local launcher_path
    local quoted_working_dir
    local quoted_script_path
    printf -v quoted_working_dir "%q" "$WORKING_DIR"
    printf -v quoted_script_path "%q" "$SCRIPT_PATH"
    launcher_path="$(mktemp /private/tmp/jworkflow-ghostty-launcher.XXXXXX)"
    cat > "$launcher_path" << LAUNCHER
#!/bin/bash
rm -f "\$0" 2>/dev/null || true
cd $quoted_working_dir
exec $quoted_script_path
LAUNCHER
    chmod +x "$launcher_path"

    if [[ -n "$GHOSTTY_WINDOW_ID" ]]; then
        osascript -e "
            tell application \"Ghostty\"
                set cfg to new surface configuration
                set initial working directory of cfg to \"$WORKING_DIR\"
                set command of cfg to \"$launcher_path\"
                set wait after command of cfg to true
                set win to window id \"$GHOSTTY_WINDOW_ID\"
                new tab in win with configuration cfg
            end tell
        " 2>/dev/null || { rm -f "$launcher_path"; return 1; }
    else
        osascript -e "
            tell application \"Ghostty\"
                set cfg to new surface configuration
                set initial working directory of cfg to \"$WORKING_DIR\"
                set command of cfg to \"$launcher_path\"
                set wait after command of cfg to true
                new window with configuration cfg
            end tell
        " 2>/dev/null || { rm -f "$launcher_path"; return 1; }
    fi
}

switch_to_abc_input
detect_window

max_retries=3
attempt=0
while [[ $attempt -lt $max_retries ]]; do
    attempt=$((attempt + 1))
    open_surface

    if [[ -z "$VERIFY_FILE" ]]; then
        exit 0
    fi

    waited=0
    while [[ $waited -lt 15 ]]; do
        if [[ -f "$VERIFY_FILE" ]]; then
            exit 0
        fi
        sleep 1
        waited=$((waited + 1))
    done

    if [[ $attempt -lt $max_retries ]]; then
        echo "[WARN] tab launch verification failed; retrying ($attempt/$max_retries)" >&2
        sleep "$attempt"
    fi
done

echo "[ERROR] failed to open Ghostty tab after $max_retries attempts" >&2
exit 1
